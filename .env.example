# =============================================================================
# NusaPDF — environment
#
# The five client-side tools (Merge, Split, Compress, PDF to JPG, JPG to PDF)
# need NONE of these: they run entirely in the browser. Only AI PDF does.
# With these unset the app still builds and runs; AI PDF shows a clear
# "belum diaktifkan" notice instead of failing.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project settings -> API. Use the ap-southeast-1 (Singapore) region to keep
# data residency aligned with UU PDP expectations (PRD §3).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used solely for quota accounting.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini -----------------------------------------------------------
# https://aistudio.google.com/apikey
# Server-only: every Gemini call goes through a Route Handler, so these keys are
# never shipped to the client.
#
# Up to four keys form a failover pool. When one hits its per-minute or per-day
# limit, NusaPDF puts it on cooldown and moves to the next automatically, so a
# spent key degrades throughput instead of taking AI PDF offline. Requests also
# start from a rotating position so load spreads across the pool rather than
# always hammering the first key.
#
# Only the first is required. Leave the rest blank if you have just one key.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# --- Model (opsional) --------------------------------------------------------
# Google memensiunkan model menurut jadwalnya sendiri — `gemini-2.5-flash`
# mulai mengembalikan 404 di tengah proyek ini. Kedua nilai di bawah bisa
# diubah tanpa menyentuh kode, dan `npm run doctor:ai` memanggil model generasi
# secara nyata sehingga pemensiunan ketahuan sebelum sampai ke pengguna.
#
# Kosongkan untuk memakai default: gemini-3.7-flash.
# Isi `gemini-flash-latest` bila Anda lebih suka alias yang tidak pernah
# pensiun — konsekuensinya perilakunya bisa bergeser sewaktu-waktu.
GEMINI_MODEL_FAST=

# Belum dipakai rute mana pun. Model Pro mengembalikan 429 pada kunci gratis,
# jadi mengaktifkan rutenya memerlukan kunci berbayar.
GEMINI_MODEL_DEEP=
