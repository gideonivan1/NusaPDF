{
  "name": "nusapdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:pdf": "node --experimental-strip-types scripts/verify-pdf-engine.mjs",
    "verify:ai": "node --import ./scripts/register-ts.mjs --conditions=react-server --experimental-strip-types scripts/verify-ai.mjs",
    "verify": "node scripts/verify-all.mjs",
    "verify:office": "node --import ./scripts/register-ts.mjs --experimental-strip-types scripts/verify-office.mjs",
    "doctor:ai": "node --import ./scripts/register-ts.mjs --conditions=react-server --experimental-strip-types scripts/doctor-ai.mjs",
    "repro:upload": "node scripts/repro-upload.mjs",
    "icons": "node scripts/make-icons.mjs",
    "measure:ingest": "node --import ./scripts/register-ts.mjs --conditions=react-server --experimental-strip-types scripts/measure-ingest.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.1",
    "nanoid": "^6.0.1",
    "next": "^16.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "linkedom": "^0.18.13",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
